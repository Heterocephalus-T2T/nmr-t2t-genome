	output:
		config["outDir"]+"/hifi/cat.done"
	threads:
		1  # Request 16 threads for this rule
	params:
		memory_per_thread="16G",
		extra_cluster_opt="",
		walltime="48:00:00",
		outDir=config["outDir"]
	shell:
		"""
		mkdir -p {params.outDir}/hifi
		cat {input}/*.fq.gz > {params.outDir}/hifi/hifi.fq.gz
		touch {output}
		"""

