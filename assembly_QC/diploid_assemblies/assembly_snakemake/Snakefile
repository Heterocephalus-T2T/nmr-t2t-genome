rule hifi_aln:
	input:
		cat=config["outDir"]+"/hifi/cat.done",
		fa=config["outDir"]+"/assembly/{hap}.fa",
		mmi=config["outDir"]+"/assembly/{hap}.mmi"
	output:
		config["outDir"]+"/hifi/{hap}.sort.bam.bai"
	threads:
		16  # Request 16 threads for this rule
	params:
		memory_per_thread="16G",
		extra_cluster_opt="",
		walltime="48:00:00",
		outDir=config["outDir"]
	shell:
		"""
		minimap2 -t {threads} -ax map-hifi {input.mmi} {params.outDir}/hifi/hifi.fq.gz | samtools view -@ {threads} -b | samtools sort -@ {threads} -o {params.outDir}/hifi/{wildcards.hap}.sort.bam
		samtools index {params.outDir}/hifi/{wildcards.hap}.sort.bam
		"""

rule ont_aln:
	input:
		cat=config["outDir"]+"/ont/ont.done",
		fa=config["outDir"] + "/assembly/{hap}.fa",
		fai=config["outDir"] + "/assembly/{hap}.fa.fai",
		mmi=config["outDir"]+"/assembly/{hap}.mmi"
	output:
		config["outDir"]+"/ont/{hap}.ont.sort.bam.bai"
	threads:
		16  # Request 16 threads for this rule
	params:
		memory_per_thread="16G",
		extra_cluster_opt="",
		walltime="48:00:00",
		outDir=config["outDir"]
	shell:
		"""
		minimap2 -t {threads} -ax map-ont --MD {input.mmi} {params.outDir}/ont/ont.fq.gz | samtools view -@ {threads} -b | samtools sort -@ {threads} -o {params.outDir}/ont/{wildcards.hap}.ont.sort.bam

		samtools index {params.outDir}/ont/{wildcards.hap}.ont.sort.bam
		"""

