		"""


rule asm_busco:
	input:
		fa=config["outDir"] + "/assembly/{hap}.fa",
		fai=config["outDir"] + "/assembly/{hap}.fa.fai"
	output:
		config["outDir"]+"/{hap}_buscoasm/busco.done"
	threads:
		24  # Request 16 threads for this rule
	params:
		memory_per_thread="16G",
		extra_cluster_opt="",
		walltime="100:00:00",
		outDir=config["outDir"],
		busco_odb=config["busco_odb"]
	shell:
		"""

		cd {params.outDir}
		
		busco --offline -i {input.fa} -o {wildcards.hap}_buscoasm -m genome --lineage_dataset {params.busco_odb} --cpu 24 -f

		touch {output}

		"""

