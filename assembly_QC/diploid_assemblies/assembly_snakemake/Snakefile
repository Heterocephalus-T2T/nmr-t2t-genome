import glob
from pathlib import Path

HAPS = ["hap1", "hap2"]

wildcard_constraints:
    hap="hap[12]"

rule all:
	input:
		# Flagger
		config["outDir"] + "/flagger/flagger.done",
		# Toga
		expand(config["outDir"] + "/toga.{hap}.done", hap=HAPS),
		# Annotation + QC rules
		expand(config["outDir"] + "/{hap}_buscoasm/busco.done", hap=HAPS),
		expand(config["outDir"] + "/{hap}_compleasm/compleasm.done", hap=HAPS),
		expand(config["outDir"] + "/{hap}_quast/quast.done", hap=HAPS),
		expand(config["outDir"] + "/{hap}.liftoff.busco.done", hap=HAPS),
		expand(config["outDir"] + "/{hap}.biser.done", hap=HAPS),
		expand(config["outDir"] + "/hifi/{hap}.sort.bam.bai", hap=HAPS),
		expand(config["outDir"] + "/{hap}_ontflagger/flagger.done", hap=HAPS)


def get_fasta_for_hap(wildcards):
	k=wildcards.hap + "Fasta"
	return config[k]


rule preprocess_data:
	input:
		get_fasta_for_hap
	output:
		fa=config["outDir"]+"/assembly/{hap}.fa",
		fai=config["outDir"]+"/assembly/{hap}.fa.fai",
		mmi=config["outDir"]+"/assembly/{hap}.mmi"
	threads: 
		1
	params:
		memory_per_thread="12G",
		extra_cluster_opt="",
		walltime="20:00:00",
		outDir=config["outDir"]
	shell:
		"""
		mkdir -p {params.outDir}/assembly
		cp -r {input} {params.outDir}/assembly/{wildcards.hap}.fa
		minimap2 -d {params.outDir}/assembly/{wildcards.hap}.mmi {params.outDir}/assembly/{wildcards.hap}.fa
		samtools faidx {params.outDir}/assembly/{wildcards.hap}.fa
		"""

rule diploid_mmi:
	input:
		fai=config["outDir"] + "/assembly/hap2.fa.fai"
	output:
		config["outDir"] + "/assembly/diploid.mmi"
	threads: 
		8
	params:
		memory_per_thread="12G",
		extra_cluster_opt="",
		walltime="20:00:00",
		outDir=config["outDir"]
	shell:
		"""
		cd {params.outDir}/assembly
		sed '/^>/ s/$/_hap1/' hap1.fa > hap1.name.fa
		sed '/^>/ s/$/_hap2/' hap2.fa > hap2.name.fa
		cat hap1.name.fa hap2.name.fa > diploid.fa
		samtools faidx diploid.fa
		minimap2 -t {threads} -d {output} diploid.fa #  indexing
		"""

rule cat_hifi_fq:
	input:
