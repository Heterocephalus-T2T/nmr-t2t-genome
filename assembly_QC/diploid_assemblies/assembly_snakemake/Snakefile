	threads:
		28 # Request 16 threads for this rule
	params:
		memory_per_thread="8G",
		extra_cluster_opt="",
		walltime="150:00:00",
		outDir=config["outDir"],
		maskDir=config["maskDir"]

	shell:
		"""
		
		bash scripts/run_mask.sh {params.outDir} {wildcards.hap} {params.maskDir} {input.fa} {output.fa} {output.bed} {threads}
		
		"""

rule liftoff:
	input:
		fa=config["outDir"] + "/assembly/{hap}.fa",
		fai=config["outDir"] + "/assembly/{hap}.fa.fai"
	output:
		config["outDir"] + "/{hap}.liftoff.busco.done" 
	threads:
		16
	params:
		memory_per_thread="4G",
		extra_cluster_opt="",
		walltime="150:00:00",
		outDir=config["outDir"],
		refLiftOffGff=config["refLiftOffGff"],
		refLiftOffFa=config["refLiftOffFa"],
		busco_odb=config["busco_odb"]
	shell: 
		"""
		
			cd {params.outDir}

			mkdir -p liftoff.{wildcards.hap} ; cd liftoff.{wildcards.hap}
			
			if [ -e "referencegff_db" ]; then
				echo "referencegff_db exists. Skipping."
			else
				# Create the file
				
				gffutils-cli create {params.refLiftOffGff} -o referencegff_db
			fi
			
			
			liftoff -db referencegff_db {input.fa} {params.refLiftOffFa} -o ./{wildcards.hap}.gff -u ./unmapped.{wildcards.hap}.txt -copies
			
			gffread {wildcards.hap}.gff -g {input.fa} -y {wildcards.hap}.faa

			busco --offline -i {wildcards.hap}.faa -o {wildcards.hap}_buscoFaa -m protein --lineage_dataset {params.busco_odb} --cpu 16 -f

			touch {output}
		"""

rule cactus_anno:
	input:
		fa=config["outDir"] + "/assembly/{hap}.sm.fa",
		bed=config["outDir"]+"/{hap}_mask/{hap}.repeat.bed"
	output:
		config["outDir"]+"/cactus_aln{hap}/target-to-ref.chain"
	threads:
		32
	params:
		memory_per_thread="12G",
		extra_cluster_opt="",
		walltime="200:00:00",

		outDir=config["outDir"],
		externalDir=config["externalDir"],
		target=config["target"],
		TogaDir=config["TogaDir"],
		refToga=config["refToga"],
		refTogaFa=config["refTogaFa"]
	shell:
		"""
		scripts/make_cactus_tree.sh {params.outDir} {params.target} {params.refToga} {params.refTogaFa} {wildcards.hap}
		scripts/cactus_align_and_chain_sif.sh {params.outDir} {params.externalDir} {params.TogaDir} {params.target} {params.refToga} {wildcards.hap}
		"""

